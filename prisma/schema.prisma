generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ร้าน / สาขา พร้อมพิกัดและรัศมีที่อนุญาตให้ตอกเวลา
model Store {
  id          Int          @id @default(autoincrement())
  name        String
  address     String?
  latitude    Float
  longitude   Float
  radiusM     Int          @default(100)
  employees   Employee[]
  attendances Attendance[]
  holidays    Holiday[]
  announcements Announcement[]
  createdAt   DateTime     @default(now())
}

/// กะงาน เช่น 09:00–18:00 พัก 60 นาที
model Shift {
  id               Int        @id @default(autoincrement())
  name             String
  startTime        String // "HH:MM"
  endTime          String // "HH:MM" (ถ้าน้อยกว่าเวลาเริ่ม = ข้ามวัน)
  breakMinutes     Int        @default(60)
  lateGraceMinutes Int        @default(5)
  workDays         String     @default("1,2,3,4,5,6") // 0=อาทิตย์ ... 6=เสาร์
  employees        Employee[]
}

model Employee {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  name           String
  phone          String?
  position       String?
  role           String       @default("STAFF") // STAFF | ADMIN
  passwordHash   String
  mustChangePassword Boolean  @default(false) // ผู้ดูแลตั้ง/รีเซ็ตรหัสให้ → ต้องเปลี่ยนเองตอนเข้าใช้ครั้งถัดไป
  passwordChangedAt  DateTime? // session ที่ออกก่อนเวลานี้จะใช้ไม่ได้ (ออกจากระบบทุกเครื่อง)
  active         Boolean      @default(true)
  photoUpdatedAt DateTime? // มีรูปโปรไฟล์หรือไม่ (ใช้ทำ cache-busting)
  photo          EmployeePhoto?
  startDate      String? // วันเริ่มงาน YYYY-MM-DD (ก่อนวันนี้จะไม่นับขาดงาน/ไม่คิดเงินเดือน)
  storeId        Int?
  store          Store?       @relation(fields: [storeId], references: [id])
  shiftId        Int?
  shift          Shift?       @relation(fields: [shiftId], references: [id])
  // ---- เงินเดือน (จำนวนเงินเก็บเป็น "สตางค์" เพื่อเลี่ยงปัญหาทศนิยม) ----
  payType        String       @default("MONTHLY") // MONTHLY | DAILY | HOURLY
  baseSalary     Int          @default(0) // เงินเดือน / ค่าแรงต่อวัน / ค่าแรงต่อชั่วโมง
  allowance      Int          @default(0) // เบี้ยเลี้ยงประจำต่อเดือน
  socialSecurity Boolean      @default(true)
  taxDeduction   Int          @default(0) // ค่าลดหย่อนภาษีเพิ่มเติมต่อปี (นอกจากส่วนตัว)
  bankName       String?
  bankAccount    String?
  taxId          String?
  attendances    Attendance[] @relation("EmployeeAttendance")
  payslips       Payslip[]
  announcementReads AnnouncementRead[]
  leaveRequests     LeaveRequest[]
  notifications     Notification[]
  confirmations     PeriodConfirmation[]
  achievements      EmployeeAchievement[]
  redemptions       RewardRedemption[]
  createdAt      DateTime     @default(now())
}

/// การตอกเวลา 1 ครั้ง (เข้า หรือ ออก) — ไม่ลบจริง ใช้การยกเลิก (void) เพื่อเก็บประวัติ
model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation("EmployeeAttendance", fields: [employeeId], references: [id])
  storeId     Int?
  store       Store?    @relation(fields: [storeId], references: [id])
  type        String // IN | OUT
  timestamp   DateTime  @default(now())
  latitude    Float?
  longitude   Float?
  accuracyM   Float?
  distanceM   Float?
  source      String    @default("GPS") // GPS | MANUAL
  note        String?
  createdById Int?
  userAgent   String?
  voidedAt    DateTime?
  voidedById  Int?
  voidNote    String?
  createdAt   DateTime  @default(now())

  @@index([employeeId, timestamp])
}

model Holiday {
  id      Int     @id @default(autoincrement())
  date    String // YYYY-MM-DD
  name    String
  storeId Int? // null = ทุกสาขา
  store   Store?  @relation(fields: [storeId], references: [id])

  @@index([date])
}

model Setting {
  key   String @id
  value String
}

model PayrollPeriod {
  id         Int       @id @default(autoincrement())
  name       String
  startDate  String // YYYY-MM-DD
  endDate    String // YYYY-MM-DD
  status     String    @default("DRAFT") // DRAFT | APPROVED | PAID
  computedAt DateTime?
  approvedAt DateTime?
  paidAt     DateTime?
  payslips   Payslip[]
  confirmations PeriodConfirmation[]
  createdAt  DateTime  @default(now())

  @@unique([startDate, endDate])
}

/// สลิปเงินเดือน — เก็บผลคำนวณเป็นตัวเลข (snapshot) ไม่คำนวณใหม่ทุกครั้งที่เปิด
model Payslip {
  id                 Int           @id @default(autoincrement())
  periodId           Int
  period             PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId         Int
  employee           Employee      @relation(fields: [employeeId], references: [id])
  payType            String
  baseSalary         Int
  workDays           Int
  absentDays         Int
  leaveDays          Int           @default(0) // ลาแบบได้รับเงิน
  unpaidLeaveDays    Int           @default(0)
  workMinutes        Int
  lateMinutes        Int
  otMinutes          Int
  holidayWorkMinutes Int
  holidayOtMinutes   Int
  basePay            Int
  holidayPay         Int
  otPay              Int
  allowance          Int
  rewardPay          Int           @default(0) // แลกเงินรางวัลสะสม (เงินได้ครั้งคราว)
  bonus              Int           @default(0)
  lateDeduction      Int
  absentDeduction    Int
  socialSecurity     Int
  withholdingTax     Int
  otherDeduction     Int           @default(0)
  grossPay           Int
  netPay             Int
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([periodId, employeeId])
}

/// รูปพนักงาน — เก็บในฐานข้อมูล (ย่อขนาดแล้ว) เพื่อให้ใช้ได้ทั้งในเครื่องและบน hosting ที่ไม่มีที่เก็บไฟล์ถาวร
model EmployeePhoto {
  employeeId Int      @id
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  data       Bytes
  mimeType   String
  updatedAt  DateTime @updatedAt
}

/// ประกาศจากผู้ดูแล
model Announcement {
  id          Int                @id @default(autoincrement())
  title       String
  body        String
  important   Boolean            @default(false) // ปักหมุดไว้บนสุด
  storeId     Int? // null = ทุกสาขา
  store       Store?             @relation(fields: [storeId], references: [id])
  expiresAt   String? // YYYY-MM-DD (แสดงถึงวันนี้) — null = ไม่หมดอายุ
  createdById Int
  reads       AnnouncementRead[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model AnnouncementRead {
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     Int
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, employeeId])
}

/// ประเภทการลา (ตั้งค่าได้) — paid = ได้รับค่าจ้าง, annualQuota = สิทธิ์ต่อปี (null = ไม่จำกัด)
model LeaveType {
  id          Int            @id @default(autoincrement())
  name        String
  paid        Boolean        @default(true)
  sick        Boolean        @default(false) // ลาป่วย: ไม่ตัดสิทธิ์ "ขยันเต็มเดือน" ถ้าไม่เกินที่ตั้งไว้
  annualQuota Int?
  color       String         @default("#3b82f6")
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  requests    LeaveRequest[]
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate    String // YYYY-MM-DD
  endDate      String // YYYY-MM-DD
  days         Int // จำนวนวันทำงานในช่วงนี้ (ไม่นับวันหยุด)
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@index([employeeId, startDate])
  @@index([status])
}

/// การแจ้งเตือนส่วนตัว (เช่น ผลการขอลา, งวดเงินเดือนพร้อม)
model Notification {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, readAt])
}

/// พนักงานยืนยัน/แจ้งแก้ไขวันทำงานของงวดเงินเดือน
/// snapshot = ตัวเลขในสลิป ณ ตอนยืนยัน ถ้าคำนวณใหม่แล้วตัวเลขเปลี่ยน ต้องยืนยันใหม่
model PeriodConfirmation {
  periodId    Int
  period      PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status      String // CONFIRMED | DISPUTED
  note        String?
  snapshot    String
  respondedAt DateTime      @default(now())

  @@id([periodId, employeeId])
}

/// ปรับเงินรางวัล/เปิดปิด ของ achievement แต่ละแบบ (คำจำกัดความอยู่ในโค้ด lib/achievement-defs.ts)
model AchievementSetting {
  key          String  @id
  rewardAmount Int // สตางค์
  active       Boolean @default(true)
}

/// badge ที่พนักงานได้รับ
model EmployeeAchievement {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  achievementKey String
  periodKey      String // เช่น "2026-10" (รายเดือน), "once" (ได้ครั้งเดียว), "manual-…"
  amount         Int // เงินรางวัล (สตางค์) ณ ตอนได้รับ
  note           String?
  awardedById    Int? // null = ระบบให้อัตโนมัติ
  awardedAt      DateTime  @default(now())
  claimedAt      DateTime? // กดรับแล้ว (เปิดดู effect)
  revokedAt      DateTime?
  revokedNote    String?

  @@unique([employeeId, achievementKey, periodKey])
  @@index([employeeId])
}

/// คำขอแลกเงินรางวัลสะสม — อนุมัติแล้วจะเข้าในงวดเงินเดือนถัดไป
model RewardRedemption {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Int // สตางค์
  status          String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED | CANCELLED
  reason          String? // RESIGNATION = จ่ายคงเหลือตอนลาออก
  reviewNote      String?
  reviewedById    Int?
  reviewedAt      DateTime?
  payslipPeriodId Int? // งวดที่จ่าย
  createdAt       DateTime  @default(now())

  @@index([employeeId, status])
}
