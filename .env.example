# ฐานข้อมูล PostgreSQL
#  - บน Railway: ตั้งเป็น ${{Postgres.DATABASE_URL}} (Railway เติมให้อัตโนมัติ)
#  - ในเครื่อง: ใช้ connection string จาก Neon (ฟรี) หรือ PostgreSQL ที่ติดตั้งเอง
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# คีย์สำหรับเซ็น session — ใช้ข้อความสุ่มยาว ๆ อย่างน้อย 32 ตัว และห้ามเผยแพร่
AUTH_SECRET="change-me-to-a-long-random-string"

# (เฉพาะ server ครั้งแรก) รหัสผ่านชั่วคราวของบัญชี admin อย่างน้อย 8 ตัว
# ถ้าไม่ตั้ง ระบบจะสุ่มให้และแสดงใน Deploy Logs
ADMIN_INITIAL_PASSWORD=""
